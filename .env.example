# Generate independent keys using: python -m proctix.cli init-env
PROCTIX_ENV=development
PROCTIX_PUBLIC_URL=http://localhost:8000
PROCTIX_DATABASE_URL=sqlite:///var/proctix.db
PROCTIX_ENCRYPTION_KEY=
PROCTIX_AUTH_KEY=
PROCTIX_KEY_ID=v1
PROCTIX_DATA_DIR=var/evidence
PROCTIX_MODEL_DIR=models
PROCTIX_RETENTION_DAYS=30
# Production Compose also requires:
# PROCTIX_DOMAIN=exam.example.org
# POSTGRES_PASSWORD=<a unique URL-safe migration password>
# PROCTIX_DB_PASSWORD=<a different URL-safe runtime password>
# Optional coturn REST authentication; match the secret on the TURN server.
# PROCTIX_TURN_URL=turns:turn.example.org:5349?transport=tcp
# PROCTIX_TURN_SECRET=<shared secret from your TURN service>
